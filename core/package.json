{
  "name": "@renote/core",
  "version": "0.1.0",
  "description": "Ядро ячейки: API и админка на Payload 4 (ADR-012)",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" payload build",
    "prebuild": "pnpm catalog",
    "catalog": "tsx scripts/modules-catalog.ts",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "predev": "pnpm catalog",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "pregenerate:types": "pnpm catalog",
    "postgenerate:types": "tsx scripts/site-types.ts",
    "lint": "eslint .",
    "migrate:create": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create",
    "premigrate:create": "pnpm catalog",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "vitest run",
    "pretest": "pnpm catalog",
    "test:int": "vitest run --config vitest.int.config.mts",
    "pretest:int": "pnpm catalog",
    "typecheck": "tsc --noEmit",
    "pretypecheck": "pnpm catalog",
    "worker": "cross-env NODE_OPTIONS=--no-deprecation CELL_ROLE=worker tsx src/worker.ts",
    "preworker": "pnpm catalog",
    "worker:dev": "cross-env NODE_OPTIONS=--no-deprecation CELL_ROLE=worker tsx watch --clear-screen=false src/worker.ts",
    "preworker:dev": "pnpm catalog"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "4.0.0-beta.5",
    "@payloadcms/next": "4.0.0-beta.5",
    "@payloadcms/richtext-lexical": "4.0.0-beta.5",
    "@payloadcms/storage-s3": "4.0.0-beta.5",
    "@payloadcms/transformer-sharp": "4.0.0-beta.5",
    "@payloadcms/translations": "4.0.0-beta.5",
    "@payloadcms/ui": "4.0.0-beta.5",
    "@renote/module-forms": "workspace:*",
    "@renote/module-legal": "workspace:*",
    "@renote/module-redirects": "workspace:*",
    "@renote/module-sdk": "workspace:*",
    "@renote/module-seo": "workspace:*",
    "croner": "10.0.1",
    "cross-env": "10.1.0",
    "dotenv": "16.4.7",
    "graphql": "^16.8.1",
    "next": "16.4.2",
    "payload": "4.0.0-beta.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "24.12.3",
    "@types/pg": "^8.15.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.4.2",
    "pg": "^8.16.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "5.0.1",
    "yaml": "^2.9.0"
  }
}
